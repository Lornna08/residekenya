{
  "name": "Reside Kenya Admin",
  "short_name": "Reside Admin",
  "description": "Listings, leads, deals, rentals and team chat for Reside Kenya.",
  "id": "/admin/",
  "start_url": "/admin/?source=app",
  "scope": "/admin/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F1F3F8",
  "theme_color": "#F1F3F8",
  "icons": [
    { "src": "/admin/icons/admin-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/admin/icons/admin-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/admin/icons/admin-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New listing", "url": "/admin/#/listings/new", "icons": [{ "src": "/admin/icons/admin-192.png", "sizes": "192x192" }] },
    { "name": "Leads", "url": "/admin/#/leads", "icons": [{ "src": "/admin/icons/admin-192.png", "sizes": "192x192" }] },
    { "name": "Team chat", "url": "/admin/#/chat", "icons": [{ "src": "/admin/icons/admin-192.png", "sizes": "192x192" }] }
  ]
}
